{
  "name": "@k11i/bolt-dynamodb",
  "version": "1.1.5",
  "description": "DynamoDB-backed InstallationStore implementation for bolt-js",
  "author": {
    "name": "KOMIYA Atsushi",
    "url": "https://github.com/komiya-atsushi"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/komiya-atsushi/slack-bolt-aws.git"
  },
  "bugs": {
    "url": "https://github.com/komiya-atsushi/slack-bolt-aws/issues"
  },
  "keywords": [
    "slack",
    "dynamodb"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist/*.*"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts --sourcemap --no-fixed-extension",
    "typecheck": "tsc --noEmit",
    "test:attw": "attw --pack ."
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1014.0"
  },
  "peerDependencies": {
    "@slack/logger": "^4.0.0 || ^5.0.0",
    "@slack/oauth": "^2.6.2 || ^3.0.1 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@slack/logger": {
      "optional": true
    },
    "@slack/oauth": {
      "optional": true
    }
  },
  "devDependencies": {
    "@slack/logger": "^5.0.0",
    "@slack/oauth": "^4.0.0"
  }
}
