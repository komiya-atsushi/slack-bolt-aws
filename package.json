{
  "name": "slack-bolt-aws",
  "version": "1.1.5",
  "description": "AWS integrations for Bolt JS",
  "author": {
    "name": "KOMIYA Atsushi",
    "url": "https://github.com/komiya-atsushi"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/komiya-atsushi/slack-bolt-aws.git"
  },
  "bugs": {
    "url": "https://github.com/komiya-atsushi/slack-bolt-aws/issues"
  },
  "scripts": {
    "typecheck": "npm --workspaces --if-present run typecheck",
    "build": "npm --workspaces --if-present run build",
    "test:vitest": "vitest --run",
    "test:attw": "npm run build && npm --workspaces --if-present run test:attw",
    "test": "npm run test:vitest && npm run test:attw",
    "lint": "npx @biomejs/biome check",
    "fix": "npx @biomejs/biome check --write",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "keywords": [],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.2.4",
    "@tsconfig/node20": "^20.1.6",
    "@types/node": "^22.18.8",
    "esbuild": "^0.27.3",
    "tsdown": "^0.23.0",
    "typescript": "~5.2.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/bolt-s3",
    "packages/example-bolt-s3",
    "packages/bolt-dynamodb",
    "packages/example-bolt-dynamodb",
    "packages/common-installation-store"
  ],
  "private": true
}
